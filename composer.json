{
    "name": "sprintf/wolfflow-bundle",
    "description": "Symfony WolffloW Bundle by Sprint-F.RU",
    "license": "BSD-3-Clause",
    "type": "symfony-bundle",
    "keywords": [
        "WolffloW",
        "Workflow",
        "Actor",
        "CQRS",
        "Event Sourcing"
    ],
    "authors": [
        {
            "name": "Albert Stepantsev",
            "email": "albert.stepantsev@sprintf.ru"
        },
        {
            "name": "Dmitry Tomak",
            "email": "d.tomak@sprintf.ru"
        }
    ],
    "homepage": "https://sprintf.ru",
    "require": {
        "php": "^8.2",
        "symfony/dependency-injection": "^7.0 || ^8.0",
        "symfony/flex": "*",
        "symfony/http-kernel": "7.0 || ^8.0",
        "symfony/service-contracts": "*",
        "symfony/translation": "7.0 || ^8.0"
    },
    "require-dev": {
        "codeception/codeception": "^5.1",
        "codeception/module-asserts": "^3.0",
        "codeception/module-phpbrowser": "*",
        "friendsofphp/php-cs-fixer": "^3.26",
        "vlucas/phpdotenv": "^5.6"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "SprintF\\Bundle\\Wolfflow\\": "src/",
            "SprintF\\Bundle\\Wolfflow\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "symfony/flex": true
        },
        "sort-packages": true
    }
}
